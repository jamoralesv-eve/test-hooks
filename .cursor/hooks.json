{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
  { "command": "./.cursor/hooks/diag.sh cursor beforeShellExecution", "timeout": 22, "failClosed": false }
],
    "beforeMCPExecution": [
      {
        "command": "\"./.cursor/hooks/cursor-hook.cmd\" cursor beforeMCPExecution",
        "timeout": 22,
        "failClosed": false
      }
    ],
    "beforeReadFile": [
      {
        "command": "\"./.cursor/hooks/cursor-hook.cmd\" cursor beforeReadFile",
        "timeout": 22,
        "failClosed": false
      }
    ],
    "afterMCPExecution": [
      {
        "command": "\"./.cursor/hooks/cursor-hook.cmd\" cursor afterMCPExecution",
        "timeout": 22,
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "command": "\"./.cursor/hooks/cursor-hook.cmd\" cursor postToolUse",
        "timeout": 22,
        "failClosed": false,
        "matcher": "^MCP:"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "\"./.cursor/hooks/cursor-hook.cmd\" cursor afterAgentResponse",
        "timeout": 22,
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "\"./.cursor/hooks/cursor-hook.cmd\" cursor stop",
        "timeout": 62,
        "failClosed": false
      }
    ],
    "sessionStart": [
      {
        "command": "\"./.cursor/hooks/cursor-hook.cmd\" cursor sessionStart",
        "timeout": 22,
        "failClosed": false
      }
    ]
  }
}
